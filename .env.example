# Copy this template to .env at the repository root, beside package.json.
# npm start/dev loads that private file into the Node.js backend only.
# Never commit a real key here or in .env, and never paste one into chat/logs.

# Leave blank to use catalogue filtering, local Test mic and demo booking without
# a provider conversation. Voice needs an AssemblyAI Voice Agent API-enabled key.
ASSEMBLYAI_API_KEY=

# HTTP port for the loopback-only server; this does not enable public access.
PORT=3000
