# Optional for voice. Keep real keys only in the ignored .env or hosting secrets.
ASSEMBLYAI_API_KEY=
# Local server port. npm start binds to loopback.
PORT=3000
# Public hosting requires a private random key of at least 32 characters.
# Vercel stores this as a sensitive environment variable.
DEMO_SIGNING_KEY=
# Optional HTTPS origin; Vercel defaults to VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_ORIGIN=
